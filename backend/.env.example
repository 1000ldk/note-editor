DATABASE_URL="postgresql://devuser:devpassword@localhost:5432/note_editor_dev?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"
# 失効直後の再提示を「盗難」ではなく「クライアントのリトライ」とみなす秒数。
# 短すぎるとモバイル回線のリトライで強制ログアウトが起きる。
REFRESH_REUSE_GRACE_SECONDS="30"
# 必須。未設定だと起動に失敗する（デフォルトでは全開放しない）。
# 全オリジンを許可する場合のみ "*" を明示的に指定する。複数指定はカンマ区切り。
# 例: ALLOWED_ORIGIN="https://app.example.com,https://staging.example.com"
ALLOWED_ORIGIN="*"
PORT=4000
